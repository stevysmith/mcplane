{
  "name": "mcplane",
  "version": "0.6.0",
  "description": "fastlane for MCP servers: preflight against every store's rejection causes, publish where you can, prepare the rest, track every review.",
  "type": "module",
  "bin": {
    "mcplane": "dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "schema.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "chatgpt",
    "claude",
    "cursor",
    "plugin",
    "connector",
    "submission",
    "fastlane"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "ajv": "^8.17.1",
    "zod": "^4.6.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevysmith/mcplane.git"
  },
  "homepage": "https://github.com/stevysmith/mcplane#readme",
  "bugs": {
    "url": "https://github.com/stevysmith/mcplane/issues"
  },
  "author": "Steve Smith",
  "mcpName": "io.github.stevysmith/mcplane",
  "exports": {
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./schema.json": "./schema.json",
    "./package.json": "./package.json"
  }
}
