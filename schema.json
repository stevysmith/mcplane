{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/mcplane/schema.json",
  "title": "mcplane.json",
  "description": "One description of an MCP server and its listings, used by mcplane to check, pack, publish and track store submissions.",
  "type": "object",
  "required": [
    "name",
    "title",
    "server"
  ],
  "additionalProperties": false,
  "$defs": {
    "store": {
      "enum": [
        "mcp-registry",
        "chatgpt",
        "claude-connectors",
        "claude-plugins",
        "cursor",
        "grok",
        "docker",
        "muse",
        "smithery",
        "glama",
        "cline",
        "lobehub",
        "awesome-mcp-servers",
        "awesome-remote-mcp-servers",
        "vercel-connect"
      ]
    },
    "url": {
      "type": "string",
      "format": "uri"
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Short machine name, lowercase with hyphens. Used for plugin entries and install links."
    },
    "title": {
      "type": "string",
      "description": "Display name in every store."
    },
    "subtitle": {
      "type": "string",
      "maxLength": 30,
      "description": "ChatGPT's subtitle (30 characters)."
    },
    "oneLiner": {
      "type": "string",
      "description": "One sentence: what it does. Claude's one-liner, the registry and plugin descriptions start from it."
    },
    "description": {
      "type": "string",
      "description": "The long description."
    },
    "category": {
      "type": "string",
      "description": "ChatGPT category: Productivity, Creativity, Developer Tools, Business & Operations, Data & Analytics, Communication, Education & Research, Security, Finance, Healthcare, Travel, Entertainment or Other (the old form's names like DEVELOPER_TOOLS are mapped)."
    },
    "server": {
      "type": "object",
      "required": [
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "url": {
          "$ref": "#/$defs/url",
          "description": "Your streamable HTTP endpoint, exactly as reviewers will add it."
        },
        "auth": {
          "enum": [
            "none",
            "oauth"
          ]
        },
        "signIn": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/url"
          },
          "description": "Sign-in pages and identity-provider URLs your consent screen sends people to. Preflight GETs them, with the authorization endpoint, to find bot challenges and 403s reviewers would hit."
        }
      }
    },
    "repository": {
      "$ref": "#/$defs/url",
      "description": "Public GitHub repository for plugin stores (Claude plugins, Cursor, Grok)."
    },
    "author": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "$ref": "#/$defs/url"
        }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "website": {
          "$ref": "#/$defs/url"
        },
        "support": {
          "$ref": "#/$defs/url"
        },
        "privacy": {
          "$ref": "#/$defs/url"
        },
        "terms": {
          "$ref": "#/$defs/url"
        },
        "docs": {
          "$ref": "#/$defs/url"
        }
      }
    },
    "icon": {
      "type": "string",
      "description": "A direct link to a square PNG, 512px or larger. Not a page, not a favicon. The ChatGPT package also takes a local path, relative to mcplane.json; other stores need the link."
    },
    "prompts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Example prompts shown on listings."
    },
    "stores": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/store"
      },
      "uniqueItems": true,
      "description": "Where you list. Leave out to check against every store."
    },
    "tests": {
      "type": "object",
      "description": "Review test cases. ChatGPT wants exactly 5 positive and 3 negative.",
      "additionalProperties": false,
      "properties": {
        "positive": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "scenario",
              "prompt",
              "tools",
              "expected"
            ],
            "additionalProperties": false,
            "properties": {
              "scenario": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              },
              "tools": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "expected": {
                "type": "string"
              }
            }
          }
        },
        "negative": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "scenario",
              "prompt"
            ],
            "additionalProperties": false,
            "properties": {
              "scenario": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "justifications": {
      "type": "object",
      "deprecated": true,
      "description": "Deprecated: OpenAI no longer asks for hint justifications. Still accepted; the ChatGPT pack lists them as optional notes for an appeal if review flags a hint.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "readOnly": {
            "type": "string"
          },
          "openWorld": {
            "type": "string"
          },
          "destructive": {
            "type": "string"
          }
        }
      }
    },
    "version": {
      "type": "string",
      "description": "Your server's version, for the MCP Registry and your records."
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Reverse-DNS name. Defaults to io.github.<owner>/<name>."
        },
        "description": {
          "type": "string",
          "maxLength": 100
        },
        "file": {
          "type": "string",
          "description": "Where to write server.json."
        }
      }
    },
    "grok": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "vercelConnect": {
      "type": "object",
      "additionalProperties": false,
      "description": "Vercel Connect's Submit a Service fields with no shared equivalent.",
      "properties": {
        "apiBase": {
          "$ref": "#/$defs/url",
          "description": "Base URL of a REST API your users also call, listed as a second target."
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Default scopes for the OAuth method. Defaults to the discovery document's scopes_supported."
        },
        "apiKey": {
          "type": "object",
          "additionalProperties": false,
          "description": "Offer an API key connection method.",
          "properties": {
            "docs": {
              "$ref": "#/$defs/url",
              "description": "Where users create a key."
            },
            "header": {
              "type": "string",
              "description": "How the key is sent, e.g. \"x-api-key: <key>\". Defaults to Authorization: Bearer <key>."
            }
          }
        }
      }
    },
    "claudePlugin": {
      "type": "object",
      "additionalProperties": false,
      "description": "The Claude Code plugin that ships this server, for \"mcplane pack claude-eval\". Read from the plugin repo when left out.",
      "properties": {
        "name": {
          "type": "string",
          "description": "The plugin's name in its plugin.json."
        },
        "server": {
          "type": "string",
          "description": "The server's key in the plugin's .mcp.json (or plugin.json mcpServers)."
        }
      }
    },
    "lanes": {
      "type": "object",
      "description": "Named workflows run with \"mcplane <lane>\". Each step is a command without \"mcplane\"; prefix \"?\" for optional, \"handoff:\" for a step only a person can do.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "reviewerAccess": {
      "type": "string",
      "description": "How reviewers get in, for servers behind sign-in. Say where credentials live; never put a password here."
    },
    "listing": {
      "type": "object",
      "description": "Per-store listing text, like fastlane's per-language metadata. Each store falls back to the top-level title, subtitle, oneLiner, description and prompts.",
      "propertyNames": {
        "$ref": "#/$defs/store"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "subtitle": {
            "type": "string"
          },
          "oneLiner": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "prompts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "chatgpt": {
      "type": "object",
      "additionalProperties": false,
      "description": "ChatGPT plugin package fields (plugin.json) with no shared equivalent.",
      "properties": {
        "developerName": {
          "type": "string",
          "description": "Publisher name (80 max). Defaults to author.name.",
          "maxLength": 80
        },
        "capabilities": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 120
          }
        },
        "brandColor": {
          "type": "string",
          "description": "#RRGGBB with 2:1 contrast against white.",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "brandColorDark": {
          "type": "string",
          "description": "#RRGGBB with 2:1 contrast against #212121.",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "logo": {
          "type": "string",
          "description": "The package's logo: an image URL or a local path relative to mcplane.json. Defaults to icon."
        },
        "composerIcon": {
          "type": "string",
          "description": "An image URL or a local path. Defaults to the logo."
        },
        "logoDark": {
          "type": "string",
          "description": "An image URL or a local path, for dark mode."
        },
        "skills": {
          "description": "Agent Skills to bundle under skills/ in the package: a folder whose subfolders each hold a SKILL.md, or a list of skill folders. Relative to mcplane.json.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "demoVideo": {
          "$ref": "#/$defs/url",
          "description": "Reviewer-accessible video URL showing the main use cases. Required for review."
        },
        "commerce": {
          "type": "boolean"
        },
        "commerceDescription": {
          "type": "string"
        },
        "countries": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          }
        },
        "releaseNotes": {
          "type": "string",
          "description": "What changed in this version. Required for review."
        },
        "translations": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "subtitle": {
                "type": "string",
                "maxLength": 30
              },
              "description": {
                "type": "string",
                "maxLength": 4000
              }
            }
          }
        }
      }
    }
  }
}
